{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:weapp": "npm run build:weapp --prefix miniapp-candidate",
    "build:weapp:clean": "npm run build:weapp:clean --prefix miniapp-candidate",
    "dev:web-candidate": "npm run dev --prefix web-candidate",
    "build:web-candidate": "npm run build --prefix web-candidate",
    "predev:api": "node scripts/ensure-dev-ports-free.mjs --api",
    "dev:api": "tsx watch server/index.ts",
    "predev:full": "node scripts/ensure-dev-ports-free.mjs --all",
    "dev:full": "concurrently -k -n ui,api -c blue,magenta \"tsx watch server.ts\" \"tsx watch server/index.ts\"",
    "predev": "node scripts/ensure-dev-ports-free.mjs --ui",
    "dev": "tsx watch server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "fix:candidate-names-from-filename": "tsx server/scripts/fix-candidate-names-from-filename.ts",
    "migrate:current-company": "tsx server/scripts/run-migration-current-company.ts",
    "db:pull-prod-test": "tsx server/scripts/pull-prod-db-to-test.ts",
    "db:migrate-dev": "tsx server/scripts/run-dev-db-migrations.ts",
    "db:verify-ai-permissions": "tsx server/scripts/verify-ai-interviewer-role-permissions.ts",
    "db:verify-interview-prompt-roles": "tsx server/scripts/verify-interview-prompt-template-roles.ts",
    "test:interview-prompt-roles": "node --import tsx --test server/tests/interview-prompt-template-roles.test.mjs",
    "start": "tsx server.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "miniapp-candidate": "file:miniapp-candidate",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tls-sig-api-v2": "^1.0.2",
    "trtc-wx-sdk": "^1.1.14",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
